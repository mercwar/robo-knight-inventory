/**
 * Traces file properties cleanly without execution folder changes ('cd').
 */
static inline int ExtractAssetMetadataBlock(const char* absolute_file_path, int* state_out) {
    if (absolute_file_path == NULL || state_out == NULL) {
        return 0;
    }
    printf("[STACKED_ENGINE] Parsing asset structural attributes at: %s\n", absolute_file_path);
    *state_out = 1; // Mark tracking state as active
    return 1;
}
